# Primary + fallback video providers. Leave empty to run mock-only.
PRIMARY_PROVIDER=mock
FALLBACK_PROVIDER=mock

# Optional paid APIs — never required for the local demo.
GEMINI_API_KEY=
LUMA_API_KEY=
RUNWAY_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
OPENAI_API_KEY=

# Director LLM (optional). If unset, the deterministic director is used.
DIRECTOR_MODEL=gpt-4o-mini

# Buffer
TARGET_BUFFER_SEC=22
SEGMENT_SEC=6.4
HOST=0.0.0.0
PORT=8080
