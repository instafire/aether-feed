# Providers: mock (no key, ffmpeg renderer) | veo | luma | runway | kling | fal
PRIMARY_PROVIDER=mock
FALLBACK_PROVIDER=mock
# Optional: a different provider for idle loops (e.g. luma for native loop:true)
LOOP_PROVIDER=

# Google Veo 3.1 (Gemini API). Also powers the director if OPENAI_API_KEY is empty.
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-fast-generate-preview

# Luma Dream Machine — needs a public origin for image keyframes.
LUMA_API_KEY=
LUMA_MODEL=ray-2
PUBLIC_BASE_URL=

# Runway
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4_turbo

# Kling
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_MODEL=kling-v2-1

# fal.ai (any image-to-video endpoint returning {"video": {"url": ...}})
FAL_KEY=
FAL_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video

# Director LLM: auto | openai | gemini | local
DIRECTOR_BACKEND=auto
OPENAI_API_KEY=
DIRECTOR_MODEL=gpt-4o-mini

# Output format: landscape (16:9) | portrait (9:16, TikTok LIVE) | square (1:1); size = short edge
STREAM_FORMAT=landscape
STREAM_SIZE=720
PLATE_PORTRAIT_PATH=../livestream_player/assets/idle_market_portrait.jpg

# Audience → stream
CHAT_WINDOW_SEC=20          # vote window
CHAT_MIN_VOTES=1
CHAT_COMMAND_PREFIX=!scene
GIFT_TIER_MEDIUM=100        # coins / bits / cents
GIFT_TIER_LARGE=1000        # large gifts interrupt the queue
GIFT_COOLDOWN_SEC=12
GIFT_MAP_JSON={}            # e.g. {"rose":"rose petals drift across the frame"}
TIKTOK_UNIQUE_ID=           # pip install TikTokLive
TWITCH_CHANNEL=
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_ID=

# Stream profile
VIDEO_CODEC=h264            # h264 (fMP4) or vp9 (WebM)
VIDEO_FPS=24
VIDEO_CRF=23
SEGMENT_SEC=8
LOOP_SEC=8
TARGET_BUFFER_SEC=18
LOW_BUFFER_SEC=8
CROSSFADE_SEC=0.33
LOOP_LIBRARY_SIZE=2
PROVIDER_TIMEOUT_SEC=420
MEDIA_DIR=media
PLATE_PATH=../livestream_player/assets/idle_market.jpg
